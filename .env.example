VOICE_USE_MOCKS=false
VOICE_ENABLE_CLOUD=true
RODIUM_API_KEY=rd_sk_votre_cle_ici
RODIUM_MODEL=google/gemini-1.5-flash
RODIUM_BASE_URL=https://api.rodiumai.io/v1
GEMINI_API_KEY=

# Photo de profil, stockee sur Cloudinary via l'API Unsigned.
# cloud name : Console Cloudinary (Settings > API Keys)
# preset      : Settings > Upload > Add upload preset > mode Unsigned
# Remplacez les valeurs ci-dessous, sinon l'upload d'avatar est refuse au
# demarrage avec un message dedie.
CLOUDINARY_CLOUD_NAME=votre_cloud_name
CLOUDINARY_UPLOAD_PRESET=votre_preset_unsigned
